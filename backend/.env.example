# Copy to .env and fill in. Required values must be set or the server won't start.

# --- Required ---
PORT=3000
NODE_ENV=development
DB_URI=mongodb+srv://<user>:<password>@<cluster>/stitch
JWT_SECRET=<long-random-string>
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

IMAGEKIT_PRIVATE_KEY=<imagekit-private-key>

RAZORPAY_API_KEY=<razorpay-key-id>
RAZORPAY_API_SECRET=<razorpay-key-secret>

# --- Optional ---
# Razorpay webhook events are rejected until this is set.
RAZORPAY_WEBHOOK_SECRET=

# Without SMTP settings, emails (verification, password reset, back-in-stock)
# are printed to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=STITCH <no-reply@stitch.local>

# Without Twilio settings, phone verification codes are printed to the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
